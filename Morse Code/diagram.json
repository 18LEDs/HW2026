{
  "version": 1,
  "author": "bryan",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-pushbutton", "id": "key", "top": 160, "left": -190,
      "attrs": { "color": "black", "label": "Telegraph Key", "bounce": "0" } },
    { "type": "board-ssd1306", "id": "oled", "top": -130, "left": 190,
      "attrs": { "i2cAddress": "0x3c" } },
    { "type": "wokwi-led", "id": "trig", "top": 110, "left": 230,
      "attrs": { "color": "green", "label": "TRIGGER" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 165, "left": 230,
      "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "esp:4", "key:1.l", "green", [ "h0" ] ],
    [ "key:2.l", "esp:GND.1", "black", [ "h0" ] ],

    [ "esp:21", "oled:SDA", "blue", [ "h0" ] ],
    [ "esp:22", "oled:SCL", "yellow", [ "h0" ] ],
    [ "esp:3V3", "oled:VCC", "red", [ "h0" ] ],
    [ "esp:GND.2", "oled:GND", "black", [ "h0" ] ],

    [ "esp:5", "trig:A", "green", [ "h0" ] ],
    [ "trig:C", "r1:1", "green", [ "h0" ] ],
    [ "r1:2", "esp:GND.3", "black", [ "h0" ] ]
  ],
  "dependencies": {}
}
