{
  "version": 1,
  "author": "bryan",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "board-mfrc522", "id": "rfid", "top": -80, "left": 200, "attrs": {} },
    { "type": "wokwi-led", "id": "trig", "top": 110, "left": 240,
      "attrs": { "color": "green", "label": "TRIGGER" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 165, "left": 240,
      "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "esp:5", "rfid:SDA", "green", [ "h0" ] ],
    [ "esp:18", "rfid:SCK", "blue", [ "h0" ] ],
    [ "esp:23", "rfid:MOSI", "orange", [ "h0" ] ],
    [ "esp:19", "rfid:MISO", "purple", [ "h0" ] ],
    [ "esp:22", "rfid:RST", "white", [ "h0" ] ],
    [ "esp:3V3", "rfid:3.3V", "red", [ "h0" ] ],
    [ "esp:GND.1", "rfid:GND", "black", [ "h0" ] ],

    [ "esp:25", "trig:A", "green", [ "h0" ] ],
    [ "trig:C", "r1:1", "green", [ "h0" ] ],
    [ "r1:2", "esp:GND.2", "black", [ "h0" ] ]
  ],
  "dependencies": {}
}
